  "pipelined" : false,
  "query" : "WITH HIJOS_POR_PERSONA AS (SELECT ID_PERSONA, COUNT(1) AS TOTAL_HIJOS FROM GS_HIJO GROUP BY ID_PERSONA) SELECT P.ID_PERSONA, P.NOMBRE, P.APELLIDO, P.ACTIVO, CAST(NVL(H.TOTAL_HIJOS, 0) AS NUMBER(10)) AS TOTAL_HIJOS FROM GS_PERSONA P LEFT JOIN HIJOS_POR_PERSONA H ON H.ID_PERSONA = P.ID_PERSONA WHERE P.ACTIVO = ? ORDER BY P.ID_PERSONA",
