  "pipelined" : false,
  "query" : "WITH PERSONAS_FILTRADAS AS (SELECT P.ID_PERSONA, P.EDAD, E.SALARIO FROM GS_PERSONA P LEFT JOIN GS_MYSQL_TIPOS_EXTRA E ON E.ID_PERSONA = P.ID_PERSONA WHERE P.ACTIVO = ?) SELECT COUNT(*) AS total_personas, COALESCE(AVG(EDAD), 0) AS edad_promedio, COALESCE(SUM(SALARIO), 0) AS salario_total FROM PERSONAS_FILTRADAS",
