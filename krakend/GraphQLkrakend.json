                {
                    "host": [
                        "http://host.docker.internal:8084"
                    ],
                    "target": "data.gsSpGetTwoCursors",
                    "url_pattern": "/graphql",
                    "method": "POST",
                    "encoding": "json",
                    "extra_config": {
                        "modifier/lua-backend": {
                            "sources": [
                                "scripts/utils.lua"
                            ],
                            "pre": "graphql_raw_request('mutation { gsSpGetTwoCursors { pPersonas { idPersona nombre apellido edad email fechaNacimiento activo fechaRegistro } pHijos { idHijo idPersona nombre apellido fechaNacimiento } } } ')",
